from sklearn.neighbors import KNeighborsClassifier
import numpy as np
import matplotlib.pyplot as plt

students = ["A", "B", "C", "D", "E"]
study_hours = [2, 3, 4, 5, 7]
assignment = [40, 45, 60, 65, 80]
final_scores = [45, 50, 62, 68, 82]
distances = [23.14, 18.06, 3.04, 2.06, 17.18]

k = 3

neighbors = sorted(zip(distances, students, final_scores), key=lambda item: item[0])

nearest = [item for item in neighbors if item[2] is not None][:k]

prediction = sum(item[2] for item in nearest) / k

print("Nearest students:")
for distance, student, score in nearest:
    print(student, "Distance:", distance, "Final:", score)

print("Predicted Final score:", round(prediction, 2))

X = np.column_stack((study_hours, assignment))

y = np.array([1 if score >= 60 else 0 for score in final_scores])

knn = KNeighborsClassifier(n_neighbors=3)
knn.fit(X, y)

plt.figure(figsize=(7, 5))

for label, name, color in [(0, "Fail", "red"), (1, "Pass", "green")]:
    mask = y == label
    plt.scatter(
        X[mask, 0],
        X[mask, 1],
        label=name,
        color=color,
        s=100
    )

plt.xlabel("Study Hours")
plt.ylabel("Assignment Score")
plt.title("KNN 2D Classification")
plt.legend()
plt.grid(True)
plt.show()
