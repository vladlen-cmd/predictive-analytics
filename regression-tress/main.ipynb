from sklearn.tree import DecisionTreeRegressor, plot_tree
import numpy as np

import matplotlib.pyplot as plt

students = ["A", "B", "C", "D", "E"]
study_hours = [2, 3, 4, 5, 7]
assignment = [40, 45, 60, 65, 80]
final_scores = [45, 50, 62, 68, 82]
distances = [23.14, 18.06, 3.04, 2.06, 17.18]

reg_tree = DecisionTreeRegressor(max_depth=3, random_state=42)
X = np.column_stack((study_hours, assignment))
reg_tree.fit(X, final_scores)

predicted_scores = reg_tree.predict(X)

print("Predicted final scores:", predicted_scores.round(2))

plt.figure(figsize=(12, 7))
plot_tree(
    reg_tree,
    feature_names=["Study Hours", "Assignment Score"],
    filled=True,
    rounded=True
)
plt.title("Decision Tree Regression")
plt.show()
